{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Folders": {
    "InputPath": "drop",
    "OutputPath": "processed"
  },
  "Processing": {
    "PollIntervalSeconds": 5,
    "Size": "ExtraSmall",
    "DeleteAfterProcessing": true
  }
}
