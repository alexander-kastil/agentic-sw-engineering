{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run picture-optimizer",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net10.0/picture-optimizer.dll",
