{
	"servers": {
		"qr-code": {
			"type": "stdio",
			"command": "uv",
			"args": [
				"run",
				"src/qr-server/server.py",
				"--stdio"
			]
		},
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp"
		},
		"playwright": {
			"command": "npx",
			"args": [
				"@playwright/mcp@latest",
				"--vision"
			],
			"type": "stdio"
		},
		"azure-deploy": {
			"command": "npx",
			"args": [
				"-y",
				"@azure/mcp@latest",
				"server",
				"start"
			],
			"type": "stdio"
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/"
		},
		"microsoft-learn": {
			"type": "http",
			"url": "https://learn.microsoft.com/api/mcp"
		},
		"ssh-mcp": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"ssh-mcp",
				"--",
				"--host=${input:SSH_HOST}",
				"--port=22",
				"--user=${input:SSH_USER}",
				"--password=${input:SSH_PASSWORD}",
				"--sudoPassword=${input:SSH_PASSWORD}",
				"--timeout=120000",
				"--maxChars=none"
			]
		},
		"work-iq": {
			"command": "npx",
			"args": [
				"-y",
				"@microsoft/workiq",
				"mcp"
			]
		},
		"devcontainers": {
			"command": "npx",
			"args": [
				"-y",
				"@crunchloop/mcp-devcontainers"
			]
		},
		"angular-cli": {
			"command": "npx",
			"args": [
				"-y",
				"@angular/cli",
				"mcp"
			]
		},
		"chrome-devtools": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"chrome-devtools-mcp@latest"
			]
		},
		"microsoft-foundry": {
			"type": "stdio",
			"command": "uvx",
			"args": [
				"--prerelease=allow",
				"--from",
				"git+https://github.com/azure-ai-foundry/mcp-foundry.git",
				"run-azure-ai-foundry-mcp"
			]
		}
	},
	"inputs": [
		{
			"id": "SSH_HOST",
			"type": "promptString",
			"description": "SSH host/IP of the Raspberry Pi",
			"default": "192.168.0.143"
		},
		{
			"id": "SSH_USER",
			"type": "promptString",
			"description": "SSH username",
			"default": "alex"
		},
		{
			"id": "SSH_PASSWORD",
			"type": "promptString",
			"description": "SSH password (used for sudo as well)",
			"password": true
		}
	]
}